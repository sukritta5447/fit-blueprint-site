{
  "headers": [
    {
      "source": "/program",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/login",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fit-blueprint-server.vercel.app/:path*"
    },
    { "source": "/(.*)", "destination": "/" }
  ],
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "dev": false,
      "feat/*": false,
      "refactor/*": false,
      "fix/*": false,
      "chore/*": false,
      "test/*": false,
      "docs/*": false,
      "style/*": false,
      "perf/*": false,
      "build/*": false,
      "ci/*": false,
      "other/*": false
    }
  }
}
